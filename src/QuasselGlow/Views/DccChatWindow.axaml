<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuasselGlow.ViewModels"
        x:Class="QuasselGlow.Views.DccChatWindow"
        x:DataType="vm:DccChatViewModel"
        Title="{Binding Title}" Width="860" Height="620" MinWidth="420" MinHeight="300"
        Background="{DynamicResource ShellBg}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" />
                <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource InkSoft}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding Strings[DccDisconnect]}"
                    Command="{Binding DisconnectCommand}" VerticalAlignment="Top" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource ShellPanel}"
                BorderBrush="{DynamicResource ShellBorder}" BorderThickness="1" CornerRadius="7" Padding="12">
            <ScrollViewer x:Name="OutputScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Output}" FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="14" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="GameComposer" Text="{Binding Draft}" MaxLength="8192"
                     PlaceholderText="{Binding Strings[DccInput]}" IsEnabled="{Binding IsConnected}"
                     FontFamily="{StaticResource MonoFontFamily}" KeyDown="OnComposerKeyDown" />
            <Button Grid.Column="1" Content="{Binding Strings[Send]}" Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</Window>
