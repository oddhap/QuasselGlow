<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        xmlns:controls="using:QuasselGlow.Controls"
        xmlns:vm="using:QuasselGlow.ViewModels"
        x:Class="QuasselGlow.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Width="1440"
        Height="920"
        MinWidth="920"
        MinHeight="620"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Icon="/Assets/Icons/quassel.ico"
        Title="Quassel Glow"
        mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.panel.muted">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
        </Style>

        <Style Selector="Button.bufferButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Button.bufferButton.selected">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.bufferButton.priority">
            <Setter Property="Background" Value="{StaticResource AccentSand}" />
        </Style>

        <Style Selector="Border.messageRow">
            <Setter Property="Background" Value="{StaticResource MessageRowBg}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,11,10,9" />
            <Setter Property="BorderBrush" Value="{StaticResource MessageRowBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Border.messageRow.self">
            <Setter Property="Background" Value="{StaticResource MessageRowSelfBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource MessageRowSelfBorder}" />
        </Style>

        <Style Selector="Border.messageRow.highlight">
            <Setter Property="Background" Value="{StaticResource MessageRowHighlightBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource MessageRowHighlightBorder}" />
        </Style>

        <Style Selector="Border.messageRow.status">
            <Setter Property="Background" Value="{StaticResource MessageRowStatusBg}" />
        </Style>

        <Style Selector="Button.infoToggle">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.infoPill">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="64" />
        </Style>

        <Style Selector="Border.userRow">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="TextBlock.userPrefix">
            <Setter Property="Width" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="TextBlock.userMode">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Border.connectionChip">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="Border.drawerShell">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>

        <Style Selector="Border.titleBarShell">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18,6,14,6" />
        </Style>

        <Style Selector="ListBox.chatList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,18,18,2" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="SelectableTextBlock.messageText">
            <Setter Property="SelectionBrush" Value="{StaticResource ComposerSelection}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource InkStrong}" />
        </Style>

        <Style Selector="HyperlinkButton.messageLink">
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.windowChrome">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
        </Style>

        <Style Selector="Button.windowChrome:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowChromeHoverBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
        </Style>

        <Style Selector="Button.windowChrome:pressed">
            <Setter Property="Background" Value="{StaticResource WindowChromePressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.windowChrome.close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeCloseFg}" />
        </Style>

        <Style Selector="Button.windowChrome.close:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowChromeCloseHoverBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeCloseHoverFg}" />
        </Style>

        <Style Selector="Button.windowChrome.close:pressed">
            <Setter Property="Background" Value="{StaticResource WindowChromeClosePressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeClosePressedFg}" />
        </Style>

        <Style Selector="Path.windowChromeIcon">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.RowSpan="4"
                Background="{StaticResource ShellBackdropBrush}" />

        <Border Grid.Row="0"
                Classes="titleBarShell"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Grid Grid.Column="0"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Margin="0,0,10,0"
                      Background="Transparent">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Source="/Assets/Icons/icon_64.png"
                               Stretch="Uniform" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Quassel"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="Glow"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource AccentTeal}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="{Binding SelectedBuffer.DisplayName, FallbackValue=Quassel Glow}"
                               Foreground="{StaticResource InkSoft}"
                               FontSize="12"
                               FontWeight="Medium" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button Classes="windowChrome"
                            Click="OnMinimizeWindowClick">
                        <Grid Width="12" Height="12">
                            <Rectangle Width="10"
                                       Height="1.4"
                                       RadiusX="0.7"
                                       RadiusY="0.7"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Classes="windowChrome"
                            Click="OnToggleMaximizeWindowClick">
                        <Grid Width="12" Height="12">
                            <Canvas x:Name="MaximizeIconCanvas"
                                    Width="12"
                                    Height="12">
                                <Rectangle Width="8"
                                           Height="7"
                                           Canvas.Left="2"
                                           Canvas.Top="2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.2" />
                            </Canvas>
                            <Canvas x:Name="RestoreIconCanvas"
                                    Width="12"
                                    Height="12"
                                    IsVisible="False">
                                <Rectangle Width="6"
                                           Height="5"
                                           Canvas.Left="4"
                                           Canvas.Top="2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.1" />
                                <Rectangle Width="6"
                                           Height="5"
                                           Canvas.Left="2"
                                           Canvas.Top="4"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.1" />
                            </Canvas>
                        </Grid>
                    </Button>

                    <Button Classes="windowChrome close"
                            Click="OnCloseWindowClick">
                        <Grid Width="12" Height="12">
                            <Path Classes="windowChromeIcon"
                                  Data="M 2 2 L 10 10 M 10 2 L 2 10" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="18,14,18,14"
              ColumnSpacing="14"
              IsVisible="{Binding !IsCompactLayout}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Classes="panel" Padding="18,14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Quassel"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkStrong}" />
                        <TextBlock Margin="0,-8,0,0"
                                   Text="Glow"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTeal}" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[ThemeLabel]}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="{Binding ThemeSummaryText}"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>

                        <Button x:Name="ThemeEditButton"
                                Grid.Column="1"
                                Classes="infoToggle"
                                Command="{Binding ToggleThemeEditorCommand}"
                                Content="{Binding Strings[Settings]}" />
                    </Grid>

                    <primitives:Popup IsOpen="{Binding IsThemeEditorOpen, Mode=TwoWay}"
                                      IsLightDismissEnabled="True"
                                      PlacementTarget="{Binding #ThemeEditButton}"
                                      Placement="BottomEdgeAlignedLeft"
                                      VerticalOffset="12">
                        <Border Classes="drawerShell"
                                Width="420"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Strings[Settings]}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ThemeSummaryText}"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            VerticalAlignment="Center"
                                            Command="{Binding CloseThemeEditorCommand}"
                                            Content="{Binding Strings[Close]}" />
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,132" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[ThemeLabel]}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkSoft}" />
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="180"
                                                  ItemsSource="{Binding SupportedThemes}"
                                                  SelectedItem="{Binding SelectedTheme}" />
                                        <ComboBox Grid.Column="2"
                                                  MinWidth="132"
                                                  ItemsSource="{Binding SupportedThemeModes}"
                                                  SelectedItem="{Binding SelectedThemeMode}" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[LanguageLabel]}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkSoft}" />
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="220"
                                                  ItemsSource="{Binding SupportedLanguages}"
                                                  SelectedValueBinding="{Binding Code}"
                                                  SelectedValue="{Binding SelectedLanguageCode}" />
                                    </Grid>

                                    <CheckBox Grid.Row="2"
                                              Content="{Binding Strings[MinimizeToTray]}"
                                              IsChecked="{Binding MinimizeToTrayEnabled}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </primitives:Popup>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel" Padding="18,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Background="{Binding ConnectionBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionStatusDetailText}"
                                   Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            MinWidth="148"
                            Padding="12,6"
                            CornerRadius="999"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSand}">
                        <TextBlock Text="{Binding CurrentNetworkText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource InkStrong}" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel" Padding="16,14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[Connection]}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="{Binding SessionSummaryText}"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>

                        <Button x:Name="ConnectionEditButton"
                                Grid.Column="1"
                                Classes="infoToggle"
                                Command="{Binding ToggleConnectionEditorCommand}"
                                Content="{Binding Strings[Edit]}" />

                        <Button Grid.Column="2"
                                Background="{StaticResource AccentTeal}"
                                Foreground="White"
                                Command="{Binding ConnectCommand}"
                                Content="{Binding Strings[Connect]}"
                                IsVisible="{Binding ShowConnectAction}" />

                        <Button Grid.Column="2"
                                Background="{StaticResource AccentRust}"
                                Foreground="White"
                                Command="{Binding DisconnectCommand}"
                                Content="{Binding Strings[Disconnect]}"
                                IsVisible="{Binding ShowDisconnectAction}" />
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding ConnectionEndpointText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding ConnectionIdentityText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding TlsModeText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                    </StackPanel>

                    <primitives:Popup IsOpen="{Binding IsConnectionEditorOpen, Mode=TwoWay}"
                                      IsLightDismissEnabled="True"
                                      PlacementTarget="{Binding #ConnectionEditButton}"
                                      Placement="BottomEdgeAlignedRight"
                                      VerticalOffset="12">
                        <Border Classes="drawerShell"
                                Width="500"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Strings[EditConnection]}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Strings[ConnectionEditorSubtitle]}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            VerticalAlignment="Center"
                                            Command="{Binding CloseConnectionEditorCommand}"
                                            Content="{Binding Strings[Close]}" />
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,96" ColumnSpacing="10">
                                        <TextBox Watermark="{Binding Strings[Host]}"
                                                 Text="{Binding Host}" />
                                        <TextBox Grid.Column="1"
                                                 Watermark="{Binding Strings[Port]}"
                                                 Text="{Binding PortText}" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <TextBox Watermark="{Binding Strings[Username]}"
                                                 Text="{Binding Username}" />
                                        <TextBox Grid.Column="1"
                                                 Watermark="{Binding Strings[Password]}"
                                                 PasswordChar="*"
                                                 Text="{Binding Password}" />
                                    </Grid>

                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Center">
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding Strings[RememberLogin]}"
                                                  IsChecked="{Binding RememberLogin}" />
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding Strings[AllowInsecureTls]}"
                                                  IsChecked="{Binding TrustInvalidCertificates}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </primitives:Popup>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="18,14,18,14"
                    Spacing="14"
                    IsVisible="{Binding IsCompactLayout}">
            <Border Classes="panel" Padding="18,14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Quassel"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkStrong}" />
                        <TextBlock Margin="0,-8,0,0"
                                   Text="Glow"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTeal}" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[ThemeLabel]}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="{Binding ThemeSummaryText}"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>

                        <Button x:Name="ThemeEditButtonCompact"
                                Grid.Column="1"
                                Classes="infoToggle"
                                Command="{Binding ToggleThemeEditorCommand}"
                                Content="{Binding Strings[Settings]}" />
                    </Grid>

                    <primitives:Popup IsOpen="{Binding IsThemeEditorOpen, Mode=TwoWay}"
                                      IsLightDismissEnabled="True"
                                      PlacementTarget="{Binding #ThemeEditButtonCompact}"
                                      Placement="BottomEdgeAlignedLeft"
                                      VerticalOffset="12">
                        <Border Classes="drawerShell"
                                Width="420"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Strings[Settings]}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ThemeSummaryText}"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            VerticalAlignment="Center"
                                            Command="{Binding CloseThemeEditorCommand}"
                                            Content="{Binding Strings[Close]}" />
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,132" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[ThemeLabel]}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkSoft}" />
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="180"
                                                  ItemsSource="{Binding SupportedThemes}"
                                                  SelectedItem="{Binding SelectedTheme}" />
                                        <ComboBox Grid.Column="2"
                                                  MinWidth="132"
                                                  ItemsSource="{Binding SupportedThemeModes}"
                                                  SelectedItem="{Binding SelectedThemeMode}" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[LanguageLabel]}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkSoft}" />
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="220"
                                                  ItemsSource="{Binding SupportedLanguages}"
                                                  SelectedValueBinding="{Binding Code}"
                                                  SelectedValue="{Binding SelectedLanguageCode}" />
                                    </Grid>

                                    <CheckBox Grid.Row="2"
                                              Content="{Binding Strings[MinimizeToTray]}"
                                              IsChecked="{Binding MinimizeToTrayEnabled}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </primitives:Popup>
                </Grid>
            </Border>

            <Border Classes="panel" Padding="18,14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Background="{Binding ConnectionBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionStatusDetailText}"
                                   Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            MinWidth="148"
                            Padding="12,6"
                            CornerRadius="999"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSand}">
                        <TextBlock Text="{Binding CurrentNetworkText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource InkStrong}" />
                    </Border>
                </Grid>
            </Border>

            <Border Classes="panel" Padding="16,14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[Connection]}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="{Binding SessionSummaryText}"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>

                        <Button x:Name="ConnectionEditButtonCompact"
                                Grid.Column="1"
                                Classes="infoToggle"
                                Command="{Binding ToggleConnectionEditorCommand}"
                                Content="{Binding Strings[Edit]}" />

                        <Button Grid.Column="2"
                                Background="{StaticResource AccentTeal}"
                                Foreground="White"
                                Command="{Binding ConnectCommand}"
                                Content="{Binding Strings[Connect]}"
                                IsVisible="{Binding ShowConnectAction}" />

                        <Button Grid.Column="2"
                                Background="{StaticResource AccentRust}"
                                Foreground="White"
                                Command="{Binding DisconnectCommand}"
                                Content="{Binding Strings[Disconnect]}"
                                IsVisible="{Binding ShowDisconnectAction}" />
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding ConnectionEndpointText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding ConnectionIdentityText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                        <Border Classes="connectionChip">
                            <TextBlock Text="{Binding TlsModeText}"
                                       Foreground="{StaticResource InkStrong}" />
                        </Border>
                    </StackPanel>

                    <primitives:Popup IsOpen="{Binding IsConnectionEditorOpen, Mode=TwoWay}"
                                      IsLightDismissEnabled="True"
                                      PlacementTarget="{Binding #ConnectionEditButtonCompact}"
                                      Placement="BottomEdgeAlignedRight"
                                      VerticalOffset="12">
                        <Border Classes="drawerShell"
                                Width="500"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Strings[EditConnection]}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Strings[ConnectionEditorSubtitle]}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            VerticalAlignment="Center"
                                            Command="{Binding CloseConnectionEditorCommand}"
                                            Content="{Binding Strings[Close]}" />
                                </Grid>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,96" ColumnSpacing="10">
                                        <TextBox Watermark="{Binding Strings[Host]}"
                                                 Text="{Binding Host}" />
                                        <TextBox Grid.Column="1"
                                                 Watermark="{Binding Strings[Port]}"
                                                 Text="{Binding PortText}" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <TextBox Watermark="{Binding Strings[Username]}"
                                                 Text="{Binding Username}" />
                                        <TextBox Grid.Column="1"
                                                 Watermark="{Binding Strings[Password]}"
                                                 PasswordChar="*"
                                                 Text="{Binding Password}" />
                                    </Grid>

                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Center">
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding Strings[RememberLogin]}"
                                                  IsChecked="{Binding RememberLogin}" />
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding Strings[AllowInsecureTls]}"
                                                  IsChecked="{Binding TrustInvalidCertificates}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </primitives:Popup>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="18,0,18,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="{Binding Strings[Network]}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkStrong}" />
                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0">
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetworkItemViewModel">
                                    <Border Classes="panel muted" Margin="0,0,0,12" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource InkSoft}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Classes="infoPill"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Grid MinWidth="36"
                                                          MinHeight="18">
                                                        <TextBlock Text="{Binding MyNick, FallbackValue=nick}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource AccentTeal}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Buffers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BufferItemViewModel">
                                                        <Button Classes="bufferButton"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Classes.priority="{Binding HasPriorityAlert}"
                                                                Command="{Binding #RootWindow.DataContext.SelectBufferCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="{Binding #RootWindow.DataContext.Strings[MarkAsRead]}"
                                                                              Command="{Binding #RootWindow.DataContext.MarkBufferAsReadCommand}"
                                                                              CommandParameter="{Binding}" />
                                                                    <Separator IsVisible="{Binding ShowBufferCommandSeparator}" />
                                                                    <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RejoinChannel]}"
                                                                              Command="{Binding #RootWindow.DataContext.RejoinChannelBufferCommand}"
                                                                              CommandParameter="{Binding}"
                                                                              IsVisible="{Binding IsChannel}" />
                                                                    <MenuItem Header="{Binding #RootWindow.DataContext.Strings[LeaveChannel]}"
                                                                              Command="{Binding #RootWindow.DataContext.LeaveChannelBufferCommand}"
                                                                              CommandParameter="{Binding}"
                                                                              IsVisible="{Binding IsChannel}" />
                                                                    <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Whois]}"
                                                                              Command="{Binding #RootWindow.DataContext.WhoisBufferCommand}"
                                                                              CommandParameter="{Binding}"
                                                                              IsVisible="{Binding IsQuery}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Border Width="24"
                                                                        Height="24"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="12"
                                                                        Background="{StaticResource BufferPrefixBg}">
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding Prefix}"
                                                                               Foreground="{StaticResource AccentTeal}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding SidebarSecondaryText}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource InkSoft}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               IsVisible="{Binding HasSidebarSecondaryText}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            Spacing="6"
                                                                            VerticalAlignment="Center">
                                                                    <Border Padding="8,4"
                                                                            CornerRadius="999"
                                                                            Background="{StaticResource AccentRust}"
                                                                            IsVisible="{Binding HasPrivateMessageAlert}">
                                                                        <TextBlock Text="PM"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="White" />
                                                                    </Border>
                                                                    <Border Padding="8,4"
                                                                            CornerRadius="999"
                                                                            Background="{StaticResource AccentSky}"
                                                                            BorderBrush="{StaticResource AccentTeal}"
                                                                            BorderThickness="1"
                                                                            IsVisible="{Binding HasMentionAlert}">
                                                                        <TextBlock Text="@"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource AccentTeal}" />
                                                                    </Border>
                                                                    <Border Padding="8,4"
                                                                            CornerRadius="999"
                                                                            Background="{StaticResource AccentSand}"
                                                                            IsVisible="{Binding HasUnread}">
                                                                        <TextBlock Text="{Binding UnreadCount}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <SplitView Grid.Column="1"
                       IsPaneOpen="{Binding IsControlPanelOpen}"
                       DisplayMode="{Binding UserListDisplayMode}"
                       OpenPaneLength="280"
                       PanePlacement="Right"
                       PaneBackground="Transparent"
                       UseLightDismissOverlayMode="{Binding UseOverlayDismissForUserList}">
                <SplitView.Content>
                    <Border Classes="panel" Padding="0">
                        <Grid RowDefinitions="76,*">
                            <Border Padding="18,16" BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedBufferHeadingText}"
                                                   FontSize="22"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedBufferSubtitleText}"
                                                   Foreground="{StaticResource InkSoft}"
                                                   IsVisible="{Binding ShowSelectedBufferSubtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            Command="{Binding ToggleControlPanelCommand}"
                                            Content="{Binding Strings[Users]}" />
                                </Grid>
                            </Border>

                            <ListBox x:Name="ChatMessagesListBox"
                                     Grid.Row="1"
                                     Classes="chatList"
                                     IsTabStop="False"
                                     ItemsSource="{Binding SelectedBuffer.Messages}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                                        <Border Classes="messageRow"
                                                Classes.self="{Binding IsSelf}"
                                                Classes.highlight="{Binding IsHighlight}"
                                                Classes.status="{Binding IsStatus}">
                                            <Grid ColumnDefinitions="52,120,*"
                                                  ColumnSpacing="12"
                                                  Margin="0,1,0,0">
                                                <TextBlock Text="{Binding TimestampText}"
                                                           Foreground="{StaticResource InkSoft}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SenderDisplay}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentRust}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <SelectableTextBlock Grid.Column="2"
                                                                     Classes="messageText"
                                                                     controls:MessageInlineRenderer.Segments="{Binding Segments}"
                                                                     TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </SplitView.Content>

                <SplitView.Pane>
                    <Border Width="280"
                            Margin="14,0,0,0"
                            Background="Transparent">
                        <Border Classes="drawerShell" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <Border Padding="18,16"
                                        BorderBrush="{StaticResource ShellBorder}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Strings[Users]}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UserListStatusText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource InkSoft}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Classes="infoToggle"
                                                    Command="{Binding ToggleUserListPinnedCommand}"
                                                    Content="{Binding UserListPinButtonText}" />
                                            <Button Classes="infoToggle"
                                                    Command="{Binding ToggleControlPanelCommand}"
                                                    Content="{Binding Strings[Hide]}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" Padding="18">
                                    <StackPanel Spacing="14">
                                        <Border Classes="panel muted"
                                                IsVisible="{Binding ShowSelectedChannelUsersUnavailable}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Strings[Users]}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Strings[UsersOnlyForChannels]}"
                                                           Foreground="{StaticResource InkSoft}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Classes="panel muted"
                                                IsVisible="{Binding ShowSelectedChannelUsersEmptyState}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Strings[Users]}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Strings[NoUsersLoaded]}"
                                                           Foreground="{StaticResource InkSoft}" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding SelectedChannelUsers}"
                                                      IsVisible="{Binding ShowSelectedChannelUsers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChannelUserViewModel">
                                                    <Border Classes="userRow">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[GiveOp]}"
                                                                          Command="{Binding #RootWindow.DataContext.GiveOpToChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RemoveOp]}"
                                                                          Command="{Binding #RootWindow.DataContext.RemoveOpFromChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[GiveVoice]}"
                                                                          Command="{Binding #RootWindow.DataContext.GiveVoiceToChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RemoveVoice]}"
                                                                          Command="{Binding #RootWindow.DataContext.RemoveVoiceFromChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Kick]}"
                                                                          Command="{Binding #RootWindow.DataContext.KickChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Ban]}"
                                                                          Command="{Binding #RootWindow.DataContext.BanChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[KickBan]}"
                                                                          Command="{Binding #RootWindow.DataContext.KickBanChannelUserCommand}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid ColumnDefinitions="18,*,Auto"
                                                              ColumnSpacing="10">
                                                            <TextBlock Classes="userPrefix"
                                                                       Text="{Binding Prefix}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Nick}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Classes="userMode"
                                                                       Text="{Binding ModeSummary}"
                                                                       IsVisible="{Binding HasModeSummary}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>
                </SplitView.Pane>
            </SplitView>
        </Grid>

        <Border Grid.Row="3"
                Margin="18,0,18,18"
                Classes="panel"
                IsVisible="{Binding !IsCompactLayout}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Classes="panel muted" Padding="12,10">
                    <TextBlock Text="{Binding ComposerContextText}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkSoft}"
                               VerticalAlignment="Center" />
                </Border>

                <TextBox Grid.Column="1"
                         Watermark="{Binding Strings[JoinOrType]}"
                         Text="{Binding DraftMessage}"
                         KeyDown="OnComposerKeyDown"
                         IsEnabled="{Binding SelectedBuffer.AcceptsInput}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="2"
                        MinWidth="112"
                        Background="{StaticResource AccentRust}"
                        Foreground="White"
                        Command="{Binding SendMessageCommand}"
                        Content="{Binding Strings[Send]}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="18,0,18,18"
                Classes="panel"
                IsVisible="{Binding IsCompactLayout}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Border Padding="12,10"
                        Classes="panel muted">
                    <TextBlock Text="{Binding ComposerContextText}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkSoft}"
                               VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Watermark="{Binding Strings[JoinOrType]}"
                             Text="{Binding DraftMessage}"
                             KeyDown="OnComposerKeyDown"
                             IsEnabled="{Binding SelectedBuffer.AcceptsInput}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            MinWidth="112"
                            Background="{StaticResource AccentRust}"
                            Foreground="White"
                            Command="{Binding SendMessageCommand}"
                            Content="{Binding Strings[Send]}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
