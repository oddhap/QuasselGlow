<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:QuasselGlow.Controls"
        xmlns:vm="using:QuasselGlow.ViewModels"
        x:Class="QuasselGlow.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Width="1440"
        Height="920"
        MinWidth="920"
        MinHeight="620"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/Icons/quassel.ico"
        Title="Quassel Glow"
        mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.titleBarShell">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <Style Selector="Border.treePane">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style Selector="Border.nickPane">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <Style Selector="Border.logPane">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
        </Style>

        <Style Selector="Border.composerBar">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="Border.statusBar">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="Border.drawerShell">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.overlayBackdrop">
            <Setter Property="Background" Value="#66000000" />
        </Style>

        <Style Selector="Button.bufferButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="Button.bufferButton:pointerover">
            <Setter Property="Background" Value="{StaticResource ShellPanel}" />
        </Style>

        <Style Selector="Button.bufferButton.selected">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.bufferButton.priority">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.bufferPrefix">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        </Style>

        <Style Selector="Border.messageRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,3,10,3" />
        </Style>

        <Style Selector="Border.messageRow:pointerover">
            <Setter Property="Background" Value="{StaticResource ShellPanelMuted}" />
        </Style>

        <Style Selector="Border.messageRow.highlight">
            <Setter Property="Background" Value="{StaticResource MessageRowHighlightBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource MessageRowHighlightBorder}" />
        </Style>

        <Style Selector="Border.messageRow.status">
            <Setter Property="Opacity" Value="0.84" />
        </Style>

        <Style Selector="TextBlock.sender">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBlock.sender.withColor">
            <Setter Property="Foreground" Value="{Binding SenderBrush}" />
        </Style>

        <Style Selector="TextBlock.sender.self">
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="TextBlock.statusMeta">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style Selector="SelectableTextBlock.statusBody">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <Style Selector="TextBlock.userPrefix">
            <Setter Property="Width" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="TextBlock.userNick">
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
        </Style>

        <Style Selector="Border.userRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,5" />
        </Style>

        <Style Selector="Border.userRow:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
        </Style>

        <Style Selector="Border.userRow:pointerover TextBlock.userNick">
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="TextBlock.userMode">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.infoToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,6" />
        </Style>

        <Style Selector="Button.infoToggle:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="Button.titleBarInfoToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.titleBarInfoToggle:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentSky}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="Button.connectButton">
            <Setter Property="Background" Value="{StaticResource AccentTeal}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="Button.disconnectButton">
            <Setter Property="Background" Value="{StaticResource AccentRust}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="Button.windowChrome">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
        </Style>

        <Style Selector="Button.windowChrome.mac">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="Opacity" Value="0.98" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pressed">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button.windowChrome.mac.closeMac">
            <Setter Property="Background" Value="#F3DED5" />
            <Setter Property="BorderBrush" Value="#CF8E72" />
        </Style>

        <Style Selector="Button.windowChrome.mac.closeMac:pointerover">
            <Setter Property="Background" Value="#EED1C4" />
            <Setter Property="BorderBrush" Value="#C77653" />
        </Style>

        <Style Selector="Button.windowChrome.mac.closeMac:pressed">
            <Setter Property="Background" Value="#E5BFAA" />
            <Setter Property="BorderBrush" Value="#BC683F" />
        </Style>

        <Style Selector="Button.windowChrome.mac.minimizeMac">
            <Setter Property="Background" Value="#F5E7C9" />
            <Setter Property="BorderBrush" Value="#D3B06A" />
        </Style>

        <Style Selector="Button.windowChrome.mac.minimizeMac:pointerover">
            <Setter Property="Background" Value="#F1DDB6" />
            <Setter Property="BorderBrush" Value="#C99C45" />
        </Style>

        <Style Selector="Button.windowChrome.mac.minimizeMac:pressed">
            <Setter Property="Background" Value="#E8CF9A" />
            <Setter Property="BorderBrush" Value="#BD8E31" />
        </Style>

        <Style Selector="Button.windowChrome.mac.maximizeMac">
            <Setter Property="Background" Value="#DBECE6" />
            <Setter Property="BorderBrush" Value="#6EA698" />
        </Style>

        <Style Selector="Button.windowChrome.mac.maximizeMac:pointerover">
            <Setter Property="Background" Value="#CCE3DA" />
            <Setter Property="BorderBrush" Value="#4F9382" />
        </Style>

        <Style Selector="Button.windowChrome.mac.maximizeMac:pressed">
            <Setter Property="Background" Value="#B8D8CC" />
            <Setter Property="BorderBrush" Value="#387A6A" />
        </Style>

        <Style Selector="Path.windowChromeMacGlyph">
            <Setter Property="Stroke" Value="#3B2F2B" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Rectangle.windowChromeMacGlyph">
            <Setter Property="Fill" Value="#3B2F2B" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RadiusX" Value="0.6" />
            <Setter Property="RadiusY" Value="0.6" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pointerover Path.windowChromeMacGlyph">
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pointerover Rectangle.windowChromeMacGlyph">
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pressed Path.windowChromeMacGlyph">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="Button.windowChrome.mac:pressed Rectangle.windowChromeMacGlyph">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="Button.windowChrome:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowChromeHoverBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkStrong}" />
        </Style>

        <Style Selector="Button.windowChrome:pressed">
            <Setter Property="Background" Value="{StaticResource WindowChromePressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.windowChrome.close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeCloseFg}" />
        </Style>

        <Style Selector="Button.windowChrome.close:pointerover">
            <Setter Property="Background" Value="{StaticResource WindowChromeCloseHoverBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeCloseHoverFg}" />
        </Style>

        <Style Selector="Button.windowChrome.close:pressed">
            <Setter Property="Background" Value="{StaticResource WindowChromeClosePressedBg}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowChromeClosePressedFg}" />
        </Style>

        <Style Selector="Path.windowChromeIcon">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style Selector="SelectableTextBlock.messageText">
            <Setter Property="SelectionBrush" Value="{StaticResource ComposerSelection}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource InkStrong}" />
        </Style>

        <Style Selector="Run.messageLink">
            <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
        </Style>

        <Style Selector="ListBox.chatList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6,0,8" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.chatList > ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Title bar -->
        <Border Grid.Row="0"
                Classes="titleBarShell"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12"
                      IsVisible="{Binding #RootWindow.IsNonMacOsPlatform}">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Image Width="14"
                               Height="14"
                               Source="/Assets/Icons/icon_64.png"
                               Stretch="Uniform" />
                        <TextBlock Text="Quassel"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource InkStrong}" />
                        <TextBlock Text="Glow"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentTeal}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="{Binding SelectedBufferHeadingText, FallbackValue=Quassel Glow}"
                               Foreground="{StaticResource InkSoft}"
                               FontSize="12"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                        <Button Classes="titleBarInfoToggle"
                                Margin="0,0,4,0"
                                Command="{Binding ToggleThemeEditorCommand}"
                                Content="{Binding Strings[Settings]}" />

                        <Button Classes="windowChrome"
                                Click="OnMinimizeWindowClick">
                            <Grid Width="12" Height="12">
                                <Rectangle Width="10"
                                           Height="1.4"
                                           RadiusX="0.7"
                                           RadiusY="0.7"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="windowChrome"
                                Click="OnToggleMaximizeWindowClick">
                            <Grid Width="12" Height="12">
                                <Canvas x:Name="MaximizeIconCanvas"
                                        Width="12"
                                        Height="12">
                                    <Rectangle Width="8"
                                               Height="7"
                                               Canvas.Left="2"
                                               Canvas.Top="2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.2" />
                                </Canvas>
                                <Canvas x:Name="RestoreIconCanvas"
                                        Width="12"
                                        Height="12"
                                        IsVisible="False">
                                    <Rectangle Width="6"
                                               Height="5"
                                               Canvas.Left="4"
                                               Canvas.Top="2"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.1" />
                                    <Rectangle Width="6"
                                               Height="5"
                                               Canvas.Left="2"
                                               Canvas.Top="4"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               StrokeThickness="1.1" />
                                </Canvas>
                            </Grid>
                        </Button>

                        <Button Classes="windowChrome close"
                                Click="OnCloseWindowClick">
                            <Grid Width="12" Height="12">
                                <Path Classes="windowChromeIcon"
                                      Data="M 2 2 L 10 10 M 10 2 L 2 10" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12"
                      IsVisible="{Binding #RootWindow.IsMacOsPlatform}">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="windowChrome mac closeMac"
                                Click="OnCloseWindowClick">
                            <Grid Width="8"
                                  Height="8">
                                <Path Classes="windowChromeMacGlyph"
                                      Data="M 1 1 L 7 7 M 7 1 L 1 7" />
                            </Grid>
                        </Button>
                        <Button Classes="windowChrome mac minimizeMac"
                                Click="OnMinimizeWindowClick">
                            <Grid Width="8"
                                  Height="8">
                                <Rectangle Classes="windowChromeMacGlyph"
                                           Width="6"
                                           Height="1.2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="windowChrome mac maximizeMac"
                                Click="OnToggleMaximizeWindowClick">
                            <Grid Width="8"
                                  Height="8">
                                <Path Classes="windowChromeMacGlyph"
                                      Data="M 4 4 L 7 1 M 5.2 1 H 7 V 2.8" />
                                <Path Classes="windowChromeMacGlyph"
                                      Data="M 4 4 L 1 7 M 1 5.2 V 7 H 2.8" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="{Binding SelectedBufferHeadingText, FallbackValue=Quassel Glow}"
                               Foreground="{StaticResource InkSoft}"
                               FontSize="12"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <Button Classes="titleBarInfoToggle"
                                Command="{Binding ToggleThemeEditorCommand}"
                                Content="{Binding Strings[Settings]}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Image Width="14"
                                   Height="14"
                                   Source="/Assets/Icons/icon_64.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="Quassel"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource InkStrong}" />
                            <TextBlock Text="Glow"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentTeal}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="1" Classes="statusBar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{Binding ConnectionBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ConnectionStatusDetailText}"
                           Foreground="{StaticResource InkSoft}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionSummaryText}"
                               Foreground="{StaticResource InkSoft}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Classes="infoToggle"
                            Command="{Binding ToggleConnectionEditorCommand}"
                            Content="{Binding Strings[Edit]}" />
                    <Button Classes="connectButton"
                            Command="{Binding ConnectCommand}"
                            Content="{Binding Strings[Connect]}"
                            IsVisible="{Binding ShowConnectAction}" />
                    <Button Classes="disconnectButton"
                            Command="{Binding DisconnectCommand}"
                            Content="{Binding Strings[Disconnect]}"
                            IsVisible="{Binding ShowDisconnectAction}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main work area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Classes="treePane">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,10">
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetworkItemViewModel">
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8"
                                              Margin="12,0,12,4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource InkSoft}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="7"
                                                        Height="7"
                                                        CornerRadius="4"
                                                        Background="{StaticResource AccentTeal}"
                                                        IsVisible="{Binding IsConnected}" />
                                                <Border Width="7"
                                                        Height="7"
                                                        CornerRadius="4"
                                                        Background="{StaticResource InkSoft}"
                                                        Opacity="0.5"
                                                        IsVisible="{Binding !IsConnected}" />
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Buffers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BufferItemViewModel">
                                                    <Button Classes="bufferButton"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Classes.priority="{Binding HasPriorityAlert}"
                                                            Command="{Binding #RootWindow.DataContext.SelectBufferCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[MarkAsRead]}"
                                                                          Command="{Binding #RootWindow.DataContext.MarkBufferAsReadCommand}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator IsVisible="{Binding ShowBufferCommandSeparator}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RejoinChannel]}"
                                                                          Command="{Binding #RootWindow.DataContext.RejoinChannelBufferCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          IsVisible="{Binding IsChannel}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[LeaveChannel]}"
                                                                          Command="{Binding #RootWindow.DataContext.LeaveChannelBufferCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          IsVisible="{Binding IsChannel}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Whois]}"
                                                                          Command="{Binding #RootWindow.DataContext.WhoisBufferCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          IsVisible="{Binding IsQuery}" />
                                                                <MenuItem Header="{Binding #RootWindow.DataContext.Strings[CloseChat]}"
                                                                          Command="{Binding #RootWindow.DataContext.CloseQueryBufferCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          IsVisible="{Binding IsQuery}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="bufferPrefix"
                                                                       Text="{Binding Prefix}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="5"
                                                                        VerticalAlignment="Center">
                                                                <Border Padding="6,2"
                                                                        CornerRadius="4"
                                                                        Background="{StaticResource AccentRust}"
                                                                        IsVisible="{Binding HasPrivateMessageAlert}">
                                                                    <TextBlock Text="PM"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="White" />
                                                                </Border>
                                                                <Border Padding="6,2"
                                                                        CornerRadius="4"
                                                                        Background="{StaticResource AccentSky}"
                                                                        IsVisible="{Binding HasMentionAlert}">
                                                                    <TextBlock Text="@"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource AccentTeal}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding UnreadCount}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource InkSoft}"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding HasUnread}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <SplitView Grid.Column="1"
                       IsPaneOpen="{Binding IsControlPanelOpen}"
                       DisplayMode="{Binding UserListDisplayMode}"
                       OpenPaneLength="260"
                       PanePlacement="Right"
                       PaneBackground="Transparent"
                       UseLightDismissOverlayMode="{Binding UseOverlayDismissForUserList}">
                <SplitView.Content>
                    <Border Classes="logPane">
                        <Grid RowDefinitions="Auto,*">
                            <Border Padding="12,8"
                                    BorderBrush="{StaticResource ShellBorder}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding SelectedBufferHeadingText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedBufferSubtitleText}"
                                               Foreground="{StaticResource InkSoft}"
                                               IsVisible="{Binding ShowSelectedBufferSubtitle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Classes="infoToggle"
                                            Command="{Binding ToggleControlPanelCommand}"
                                            Content="{Binding Strings[Users]}"
                                            IsVisible="{Binding ShowUserListToggle}" />
                                </Grid>
                            </Border>

                            <ListBox x:Name="ChatMessagesListBox"
                                     Grid.Row="1"
                                     Classes="chatList"
                                     IsTabStop="False"
                                     ItemsSource="{Binding SelectedBuffer.Messages}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto,*"
                                                  ColumnSpacing="12"
                                                  Margin="8,10,8,6"
                                                  IsVisible="{Binding IsDaySeparatorVisible}">
                                                <Border Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource ShellBorder}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DaySeparatorText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkSoft}" />
                                                <Border Grid.Column="2"
                                                        Height="1"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource ShellBorder}" />
                                            </Grid>
                                            <Border Classes="messageRow"
                                                    Classes.self="{Binding IsSelf}"
                                                    Classes.highlight="{Binding IsHighlight}"
                                                    Classes.status="{Binding IsStatus}">
                                                <Grid ColumnDefinitions="44,Auto,*"
                                                      ColumnSpacing="8"
                                                      Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               Classes.statusMeta="{Binding IsStatus}"
                                                               Foreground="{StaticResource InkSoft}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="12"
                                                               VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="sender"
                                                               Classes.withColor="{Binding !IsSelf}"
                                                               Classes.self="{Binding IsSelf}"
                                                               Text="{Binding SenderDisplay}"
                                                               IsVisible="{Binding HasSender}" />
                                                    <SelectableTextBlock Grid.Column="{Binding MessageColumn}"
                                                                         Grid.ColumnSpan="{Binding MessageColumnSpan}"
                                                                         Classes="messageText"
                                                                         Classes.statusBody="{Binding IsStatus}"
                                                                         controls:MessageInlineRenderer.Segments="{Binding Segments}"
                                                                         TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </SplitView.Content>

                <SplitView.Pane>
                    <Border Classes="nickPane">
                        <Grid RowDefinitions="Auto,*">
                            <Border Padding="12,9"
                                    BorderBrush="{StaticResource ShellBorder}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Strings[Users]}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UserListStatusText}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkSoft}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="infoToggle"
                                            VerticalAlignment="Center"
                                            Command="{Binding ToggleControlPanelCommand}"
                                            Content="{Binding Strings[Hide]}" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Padding="6,8">
                                <StackPanel Spacing="6">
                                    <Border Padding="10"
                                            Background="{StaticResource ShellPanel}"
                                            BorderBrush="{StaticResource ShellBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsVisible="{Binding ShowSelectedChannelUsersUnavailable}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Strings[Users]}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Strings[UsersOnlyForChannels]}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkSoft}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="10"
                                            Background="{StaticResource ShellPanel}"
                                            BorderBrush="{StaticResource ShellBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsVisible="{Binding ShowSelectedChannelUsersEmptyState}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Strings[Users]}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Strings[NoUsersLoaded]}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource InkSoft}" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding SelectedChannelUsers}"
                                                  IsVisible="{Binding ShowSelectedChannelUsers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChannelUserViewModel">
                                                <Border Classes="userRow"
                                                        PointerPressed="OnChannelUserPointerPressed">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[GiveOp]}"
                                                                      Command="{Binding #RootWindow.DataContext.GiveOpToChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RemoveOp]}"
                                                                      Command="{Binding #RootWindow.DataContext.RemoveOpFromChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[GiveVoice]}"
                                                                      Command="{Binding #RootWindow.DataContext.GiveVoiceToChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[RemoveVoice]}"
                                                                      Command="{Binding #RootWindow.DataContext.RemoveVoiceFromChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Kick]}"
                                                                      Command="{Binding #RootWindow.DataContext.KickChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[Ban]}"
                                                                      Command="{Binding #RootWindow.DataContext.BanChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{Binding #RootWindow.DataContext.Strings[KickBan]}"
                                                                      Command="{Binding #RootWindow.DataContext.KickBanChannelUserCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnDefinitions="16,*,Auto"
                                                          ColumnSpacing="8">
                                                        <TextBlock Classes="userPrefix"
                                                                   Text="{Binding Prefix}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="userNick"
                                                                   Text="{Binding Nick}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Classes="userMode"
                                                                   Text="{Binding ModeSummary}"
                                                                   IsVisible="{Binding HasModeSummary}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </SplitView.Pane>
            </SplitView>
        </Grid>

        <!-- Composer -->
        <Border Grid.Row="3" Classes="composerBar">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MainComposerTextBox"
                         Grid.Column="0"
                         PlaceholderText="{Binding Strings[JoinOrType]}"
                         Text="{Binding DraftMessage}"
                         KeyDown="OnComposerKeyDown"
                         IsEnabled="{Binding SelectedBuffer.AcceptsInput}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1"
                        MinWidth="104"
                        Classes="connectButton"
                        Command="{Binding SendMessageCommand}"
                        Content="{Binding Strings[Send]}" />
            </Grid>
        </Border>

        <!-- Settings overlay -->
        <Border Grid.RowSpan="4"
                Classes="overlayBackdrop"
                IsVisible="{Binding IsThemeEditorOpen}">
            <Border Classes="drawerShell"
                    Width="470"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[Settings]}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ThemeSummaryText}"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="infoToggle"
                                VerticalAlignment="Center"
                                Command="{Binding CloseThemeEditorCommand}"
                                Content="{Binding Strings[Close]}" />
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*,120" ColumnSpacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings[ThemeLabel]}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="200"
                                      ItemsSource="{Binding SupportedThemes}"
                                      SelectedItem="{Binding SelectedTheme}" />
                            <ComboBox Grid.Column="2"
                                      MinWidth="120"
                                      ItemsSource="{Binding SupportedThemeModes}"
                                      SelectedItem="{Binding SelectedThemeMode}" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings[LanguageLabel]}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="220"
                                      ItemsSource="{Binding SupportedLanguages}"
                                      SelectedValueBinding="{Binding Code}"
                                      SelectedValue="{Binding SelectedLanguageCode}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <CheckBox Content="{Binding Strings[MinimizeToTray]}"
                                      IsChecked="{Binding MinimizeToTrayEnabled}" />
                            <CheckBox Content="{Binding Strings[UseClassicLayout]}"
                                      IsChecked="{Binding UseClassicLayout}" />
                        </StackPanel>

                        <CheckBox Grid.Row="3"
                                  Content="{Binding Strings[ShowDaySeparators]}"
                                  IsChecked="{Binding ShowDaySeparators}" />

                        <TextBlock Grid.Row="4"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Text="{Binding VersionText, StringFormat=QuasselGlow {0}}"
                                   FontSize="11"
                                   Foreground="{StaticResource InkSoft}"
                                   Opacity="0.72" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Connection editor overlay -->
        <Border Grid.RowSpan="4"
                Classes="overlayBackdrop"
                IsVisible="{Binding IsConnectionEditorOpen}">
            <Border Classes="drawerShell"
                    Width="540"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Strings[EditConnection]}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Strings[ConnectionEditorSubtitle]}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource InkSoft}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="infoToggle"
                                VerticalAlignment="Center"
                                Command="{Binding CloseConnectionEditorCommand}"
                                Content="{Binding Strings[Close]}" />
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,96" ColumnSpacing="10">
                            <TextBox PlaceholderText="{Binding Strings[Host]}"
                                     Text="{Binding Host}" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="{Binding Strings[Port]}"
                                     Text="{Binding PortText}" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <TextBox PlaceholderText="{Binding Strings[Username]}"
                                     Text="{Binding Username}" />
                            <TextBox Grid.Column="1"
                                     PlaceholderText="{Binding Strings[Password]}"
                                     PasswordChar="*"
                                     Text="{Binding Password}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <CheckBox Content="{Binding Strings[RememberLogin]}"
                                  IsChecked="{Binding RememberLogin}" />
                        <CheckBox Content="{Binding Strings[AutoConnectOnStartup]}"
                                  IsChecked="{Binding AutoConnectOnStartup}"
                                  IsEnabled="{Binding RememberLogin}" />
                        <CheckBox Content="{Binding Strings[AutoReconnect]}"
                                  IsChecked="{Binding AutoReconnect}" />
                        <CheckBox Content="{Binding Strings[AllowInsecureTls]}"
                                  IsChecked="{Binding TrustInvalidCertificates}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
